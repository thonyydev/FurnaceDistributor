{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "${mod_license}",
  "icon": "assets/furnacedistributor/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.thonyy.furnacedistributor.fabric.FurnaceDistributorFabric"
    ],
    "client": [
      "com.thonyy.furnacedistributor.fabric.client.FurnaceDistributorFabricClient"
    ]
  },
  "mixins": [
    "furnacedistributor.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "architectury": ">=${architectury_api_version} <14.0.0",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
