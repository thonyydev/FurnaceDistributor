{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "icon": "logo.png",
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.thonyy.furnacedistributor.fabric.FurnaceDistributorFabric"
    ],
    "client": [
      "com.thonyy.furnacedistributor.fabric.client.FurnaceDistributorFabricClient"
    ],
    "modmenu": [
      "com.thonyy.furnacedistributor.fabric.client.FurnaceDistributorModMenu"
    ]
  },
  "mixins": [
    "furnacedistributor.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "architectury": ">=${architectury_api_version} <22.0.0",
    "fabric-api": ">=${fabric_api_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
